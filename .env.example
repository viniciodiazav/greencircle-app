# =============================================================================
# VARIABLES DE ENTORNO DEL FRONTEND (Vite / React)
# Nota: En Vite, todas las variables públicas deben llevar el prefijo 'VITE_'
# =============================================================================

# URL del Backend FastAPI (Dejar vacío en desarrollo para usar el proxy local /api)
# En producción (ej. Seenode, Vercel, Netlify): coloca la URL de tu backend en Seenode
# Ejemplo: VITE_API_URL=https://greencircle-api.seenode.app
VITE_API_URL=

# Ruta secreta para el panel de administración móvil (opcional, por defecto 'gAca26vd8')
VITE_ADMIN_PATH=gAca26vd8
